<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<style>
		body {
			cursor: url('/images/cursor.png'), auto;
		}

		p {
			padding: 0;
			margin: 0;
		}

		.window {
			width: 300px;
			min-height: 300px;
			background: #bfbfbf;
			position: fixed;
			left: 30px;
			top: 40px;
			display: flex;
			flex-direction: column;
			padding: 4px;
		}

		.window-top {
			background: #000080;
			padding: 10px;
		}
	</style>
	<body style="width: 100vw; height: 100vh; background: #008080">
		<div id="window" class="window">
			<div
				id="window-top"
				class="window-top"
			>
				<p style="color: white; user-select: none">Welcome!</p>
			</div>

			<div style="padding: 12px">
				<p style="color: black">Here's a secret about me: I love writing, but I never do it! Guess it isn't much of a secret, huh?</p>
			</div>
		</div>
	</body>
	<script is:inline>
		const myWindow = document.getElementById("window");
		const windowTop = document.getElementById("window-top");

		const clickSounds = [
			new Audio("/sounds/click/click1.mp3"),
			new Audio("/sounds/click/click2.mp3"),
		]

		let move = false;
		let offsetX = 0;
		let offsetY = 0;

		windowTop.addEventListener("mousedown", (e) => {
			move = true;
			offsetX = e.offsetX;
			offsetY = e.offsetY;
		})

		document.addEventListener('DOMContentLoaded', function() {
			console.log("loaded")
			const startSound = new Audio("/sounds/start.mp3")
			startSound.play()
		})

		document.addEventListener("mousedown", (e) => {
			clickSounds[Math.floor(Math.random() * clickSounds.length)].cloneNode().play()
		})

		document.addEventListener("mouseup", (e) => {
			move = false;
		});

		document.addEventListener("mousemove", function (e) {
			if (!move) {
				return;
			}

			if (e.clientX < 0 || e.clientX > window.innerWidth) {
				return;
			}

			if (e.clientY < 0 || e.clientY > window.innerHeight) {
				return;
			}

			const finalX = e.clientX - offsetX;
			const finalY = e.clientY - offsetY;

			myWindow.style.position = "fixed";
			myWindow.style.left = `${finalX}px`;
			myWindow.style.top = `${finalY}px`;
		});
	</script>
</html>
